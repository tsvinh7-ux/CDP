<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cdp_event_rule_view_tree" model="ir.ui.view">
        <field name="name">cdp.event.rule.tree</field>
        <field name="model">cdp.event.rule</field>
        <field name="arch" type="xml">
            <tree>
                <field name="event_type"/>
                <field name="model_id"/>
                <field name="trigger_field_id"/>
                <field name="trigger_value"/>
                <field name="partner_path"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>
    <record id="cdp_event_rule_view_form" model="ir.ui.view">
        <field name="name">cdp.event.rule.form</field>
        <field name="model">cdp.event.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h1><field name="name" readonly="1"/></h1>
                    <group>
                        <group>
                            <field name="event_type"/>
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="partner_path"/>
                        </group>
                        <group>
                            <field name="trigger_field_id" options="{'no_create': True}"/>
                            <field name="trigger_value" invisible="not trigger_field_id" required="trigger_field_id"/>
                            <field name="automation_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <tree editable="bottom">
                            <field name="prop"/>
                            <field name="field_path"/>
                        </tree>
                    </field>
                    <div class="text-muted">
                        Thuộc tính theo data contract: lịch hẹn (scheduled_at, service_group, branch_id), kế hoạch điều trị
                        (amount, service_groups), thủ thuật (service_group, amount), trả góp (plan_id, amount, due_date).
                        Không gửi ghi chú lâm sàng, chẩn đoán, phim X-quang.
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_cdp_event_rule" model="ir.actions.act_window">
        <field name="name">Sự kiện Dental ERP</field>
        <field name="res_model">cdp.event.rule</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="menu_cdp_event_rule" name="Sự kiện Dental ERP" parent="cdp_base.menu_cdp_config"
              action="action_cdp_event_rule" sequence="25"/>
</odoo>

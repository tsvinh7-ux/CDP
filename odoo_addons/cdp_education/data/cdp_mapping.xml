<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <function model="cdp.mapping" name="add_fields">
        <value eval="[ref('cdp_base.mapping_res_partner')]"/>
        <value eval="['dental_role']"/>
    </function>

    <record id="mapping_slide_channel" model="cdp.mapping">
        <field name="model_id" ref="website_slides.model_slide_channel"/>
        <field name="field_ids" eval="[(6, 0, [
            ref('website_slides.field_slide_channel__name'),
            ref('website_slides.field_slide_channel__tag_ids'),
            ref('website_slides.field_slide_channel__enroll'),
            ref('website_slides.field_slide_channel__total_slides'),
            ref('website_sale_slides.field_slide_channel__product_id'),
            ref('website_slides.field_slide_channel__is_published'),
        ])]"/>
    </record>

    <record id="mapping_sale_order" model="cdp.mapping">
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="field_ids" eval="[(6, 0, [
            ref('sale.field_sale_order__partner_id'),
            ref('sale.field_sale_order__state'),
            ref('sale.field_sale_order__amount_total'),
            ref('sale.field_sale_order__date_order'),
            ref('website_sale.field_sale_order__website_id'),
        ])]"/>
    </record>
</odoo>

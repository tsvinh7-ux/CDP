<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_cdp" model="ir.module.category">
        <field name="name">CDP</field>
        <field name="sequence">60</field>
    </record>
    <record id="group_cdp_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_cdp"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_cdp_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_cdp"/>
        <field name="implied_ids" eval="[(4, ref('group_cdp_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>

# Copy to .env and replace every value.
POSTGRES_PASSWORD=change-me-postgres
CLICKHOUSE_PASSWORD=change-me-clickhouse
# Token for the admin API and console (/console?token=...)
CDP_ADMIN_TOKEN=change-me-admin
# Fernet key encrypting destination secrets:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CDP_MASTER_KEY=
# inline | queue  (queue: API acknowledges, cdp-consumer processes)
CDP_INGEST_MODE=queue
# postgres | kafka (kafka needs: docker compose --profile kafka up)
CDP_QUEUE_BACKEND=postgres
CDP_PORT=8000
